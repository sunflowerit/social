<?xml version="1.0" encoding="UTF-8"?>
<template>
<!--    Put the buttons in the view for odoo 14-->
    <t t-name="MyComponent" t-inherit="mail.Message" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_Message_header')]" t-operation="inside">
<!--         <t t-if="message.isCurrentPartnerAuthor or message.messagingCurrentPartner.im_status == 'bot'">-->
                <span class="o_MessageEdit">
                    <i
                        class="fa o_mail_edit_delete fa-pencil"
                        t-att-data-message-id="message.localId"
                        t-on-click="_onClickEdit"
                        title="Edit Message"
                    />
                </span>
                <span class="o_MessageDelete">
                    <i
                        class="fa o_mail_edit_delete fa-trash"
                        t-att-data-message-id="message.localId"
                        t-on-click="_onClickDelete"
                        title="Delete Message"
                    />
                </span>
        </xpath>
    </t>
</template>

